# Public Supabase project configuration, used by the existing admin CMS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=cms-images

# Optional metadata display identifier. No administrator/service-role key is needed.
# VOSCAST_STATS_KEY=your-voscast-display-identifier

# Existing wp-client helper is not wired into public routes; its expected base URL:
# WP_BASE_URL=https://radioppidunia.org

# Enable production CMS only after verifying live RLS/Storage policies.
RPD_ADMIN_ENABLED=false
